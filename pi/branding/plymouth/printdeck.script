// PrintDeck boot screen: logo + sliding loading bar
Window.SetBackgroundTopColor(0.027, 0.035, 0.051);
Window.SetBackgroundBottomColor(0.027, 0.035, 0.051);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 20;
logo.sprite.SetPosition(logo.x, logo.y, 1);

track.image = Image("track.png");
track.sprite = Sprite(track.image);
track.x = Window.GetX() + Window.GetWidth() / 2 - track.image.GetWidth() / 2;
track.y = logo.y + logo.image.GetHeight() + 24;
track.sprite.SetPosition(track.x, track.y, 2);

seg.image = Image("seg.png");
seg.sprite = Sprite(seg.image);
seg.range = track.image.GetWidth() - seg.image.GetWidth();
seg.sprite.SetPosition(track.x, track.y, 3);

t = 0;
fun refresh_callback() {
  t = t + 0.06;
  pos = (1 - Math.Cos(t)) / 2;            // smooth back-and-forth 0..1
  seg.sprite.SetX(track.x + seg.range * pos);
}
Plymouth.SetRefreshFunction(refresh_callback);

// Hide password/question prompts' default text clutter (none expected on a Pi)
fun message_callback(text) { }
Plymouth.SetMessageFunction(message_callback);
